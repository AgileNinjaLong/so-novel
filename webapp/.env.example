# 复制为 .env 后按需修改；docker compose 会自动读取
# 管理员账号（必须设置，否则无法进入 /admin）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 下载完成后临时文件的保留分钟数（供用户接收），超时自动删除
WEBAPP_FILE_TTL_MIN=120

# HTTPS / 反向代理部署时设为 1，让登录 Cookie 带 Secure
WEBAPP_COOKIE_SECURE=0

# 默认来源：sonovel 或 tomato
WEBAPP_DEFAULT_SOURCE=sonovel
# 与番茄服务之间的内部口令（仅容器内 127.0.0.1 通信）
TOMATO_PASSWORD=webapp-internal
# 单任务超时秒数，0 = 不限
WEBAPP_TASK_TIMEOUT=0
